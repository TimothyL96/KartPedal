/.venv/
/firmware/.tools/
/firmware/KartPedal/build/
__pycache__/
*.pyc
*.nbc
*.nbi
*.elf
*.map
/firmware/build/host/*
!/firmware/build/host/golden.bin
/firmware/provision.log
/firmware/compile.log

# Keep release fixtures and their expected results, apart from exploratory runs.
/measurement/artifacts/*
!/measurement/artifacts/outing/
!/measurement/artifacts/refit2/
!/measurement/artifacts/refit3/
!/measurement/artifacts/holdout/
!/measurement/artifacts/final/
!/measurement/artifacts/endurance-final/
!/measurement/artifacts/verified/
/measurement/artifacts/verified/*
!/measurement/artifacts/verified/refit2/
!/measurement/artifacts/verified/refit3/
!/measurement/artifacts/verified/holdout/
!/measurement/artifacts/benchmark-final/
/measurement/artifacts/benchmark-final/*
!/measurement/artifacts/benchmark-final/benchmark.json

# Only the published synthetic benchmark report belongs in Git under user-data.
/measurement/user-data/*
!/measurement/user-data/exports/
/measurement/user-data/exports/*
!/measurement/user-data/exports/release-endurance/
/measurement/user-data/exports/release-endurance/*
!/measurement/user-data/exports/release-endurance/benchmark.json
